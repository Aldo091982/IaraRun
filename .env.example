# Copie para .env e ajuste. NUNCA versione o .env com segredos.

# development | test | production  (cada ambiente usa seu próprio banco e pasta de arquivos)
APP_ENV=development
PORT=3000
# 127.0.0.1 quando houver proxy ou túnel na frente (recomendado em produção)
HOST=0.0.0.0
BASE_URL=http://localhost:3000
APP_NAME=Largada

# Obrigatório em produção: valor longo e aleatório
SESSION_SECRET=

# ---------- Banco de dados (PostgreSQL 13+) ----------
# Vazio fora de produção = PostgreSQL local automático (porta 54329, dados em storage/pg/dev).
# Produção: obrigatório. Ex.: postgres://usuario:senha@host:5432/plataforma
DATABASE_URL=
# 1 se o provedor exigir SSL
DATABASE_SSL=
# DB_POOL_SIZE=10

# Arquivos (padrão: storage/{private,public}/<ambiente>)
# PRIVATE_STORAGE_DIR=   # documentos de identidade — fora de qualquer pasta pública, com backup criptografado
# PUBLIC_UPLOAD_DIR=     # logomarcas e capas

# ---------- Integrações ----------
# Todas as integrações abaixo também podem ser configuradas pela tela Administração › Integrações
# (o valor salvo na tela tem prioridade). Senhas e chaves da tela ficam criptografadas no banco com
# esta chave; se vazia, deriva do SESSION_SECRET. Se a chave mudar, informe os segredos de novo na tela.
SETTINGS_ENCRYPTION_KEY=

# ---------- Mercado Pago ----------
# Sem MP_ACCESS_TOKEN (fora de produção) o simulador local de DEMONSTRAÇÃO é usado.
# Credencial de teste começa com TEST-  → ambiente de testes do Mercado Pago.
# Credencial de produção só habilita cobranças se PAYMENT_RECEIVER_MODEL estiver decidido.
MP_ACCESS_TOKEN=
# Chave secreta das notificações (Painel do desenvolvedor › Webhooks). Webhooks sem assinatura válida são recusados.
MP_WEBHOOK_SECRET=
# Opcional: ID da conta recebedora esperada (valida o beneficiário de cada pagamento)
MP_COLLECTOR_ID=
# undecided | platform | organizer  (DECISÃO DE NEGÓCIO PENDENTE)
PAYMENT_RECEIVER_MODEL=undecided
# Somente para o modelo "organizer" (OAuth do Mercado Pago)
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# ---------- Entrar com o Google (OpenID Connect) ----------
# Google Cloud Console › APIs e serviços › Credenciais › ID do cliente OAuth (aplicativo da Web).
# URI de redirecionamento autorizado: https://SEU_DOMINIO/entrar/google/retorno
# Vazio fora de produção = simulador local; vazio em produção = botão do Google oculto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Meios de pagamento oferecidos ao atleta (ordem de exibição) ----------
PAYMENT_METHODS=mercadopago,paypal,picpay

# ---------- PayPal (Orders v2) ----------
# Sem credenciais (fora de produção) o simulador local é usado.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live  (live também exige PAYMENT_RECEIVER_MODEL decidido)
PAYPAL_ENV=sandbox
# ID do webhook cadastrado no painel do PayPal (URL https://SEU_DOMINIO/webhooks/paypal). Sem ele, webhooks são recusados.
PAYPAL_WEBHOOK_ID=
# Opcional: merchant ID esperado como recebedor
PAYPAL_MERCHANT_ID=

# ---------- PicPay (API de e-commerce) ----------
# Credencial configurada = produção (o PicPay não oferece ambiente de testes público).
PICPAY_TOKEN=
# Token que o PicPay envia no callback (cabeçalho x-seller-token). URL de callback: https://SEU_DOMINIO/webhooks/picpay
PICPAY_SELLER_TOKEN=

# ---------- Consulta cadastral de CNPJ (fornecedor autorizado) ----------
# Vazio = cadastro manual identificado como "pendente de verificação".
CNPJ_PROVIDER=
CNPJ_PROVIDER_URL=https://seu-fornecedor.exemplo/v1/cnpj/{cnpj}
CNPJ_PROVIDER_TOKEN=
CNPJ_PROVIDER_NAME=

# ---------- E-mail (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
# starttls | tls | none
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Largada <nao-responda@seu-dominio.com.br>

# ---------- SMS e WhatsApp (Twilio) ----------
# twilio | vazio (desativado). Só recebe quem autorizar em Minha conta › Preferências.
MESSAGING_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ---------- Medição (carregada somente após consentimento do visitante) ----------
GA_MEASUREMENT_ID=
META_PIXEL_ID=
