{
  "name": "plataforma-esportiva",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de eventos esportivos: inscrições, pagamentos, kits e resultados",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "db:start": "node scripts/pg-local.js start dev",
    "db:stop": "node scripts/pg-local.js stop dev",
    "db:status": "node scripts/pg-local.js status dev",
    "migrate": "node --no-warnings scripts/migrate.js",
    "seed": "node --no-warnings scripts/seed.js",
    "test": "node --no-warnings --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "embedded-postgres": "^17.5.0-beta.15"
  }
}
